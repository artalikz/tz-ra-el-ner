<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Мой план тренировок</title><style>
:root{--bg:#101216;--c:#181b21;--c2:#20242c;--t:#eef1f5;--m:#8f98a6;--a:#4cc9f0;--w:#ff7a59;--b:#2b303a}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth}body{background:var(--bg);color:var(--t);font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif;padding-bottom:40px}
nav{position:sticky;top:0;z-index:5;background:#101216ee;backdrop-filter:blur(8px);display:flex;gap:6px;overflow-x:auto;padding:10px 12px;border-bottom:1px solid var(--b)}
nav button,.tabs button{flex:none;background:var(--c);color:var(--m);border:1px solid var(--b);border-radius:20px;padding:8px 14px;font:inherit;cursor:pointer}
nav button.on,.tabs button.on{background:var(--a);color:#06222b;border-color:var(--a);font-weight:600}
main{max-width:860px;margin:auto;padding:16px 14px}h1{font-size:26px;margin:6px 0 4px}h2{font-size:20px;margin:6px 0 10px}h3{font-size:17px}
.m{color:var(--m);font-size:14px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:12px 0}
.card{background:var(--c);border:1px solid var(--b);border-radius:14px;padding:14px;margin:10px 0}.grid .card{margin:0}
.big{font-size:26px;font-weight:700;color:var(--a)}.day{cursor:pointer;transition:transform .15s,border-color .15s}.day:hover{transform:translateY(-2px);border-color:var(--a)}
.ic{font-size:26px}.eh{display:flex;gap:12px;align-items:center}.tags{display:flex;gap:8px;margin:8px 0}.tags span{background:var(--c2);border-radius:8px;padding:3px 10px;font-size:13px}
.set{display:grid;grid-template-columns:56px 1fr 1fr;gap:8px;align-items:center;margin:6px 0}.set label{display:flex;gap:6px;align-items:center}
input[type=number],select{background:var(--c2);border:1px solid var(--b);color:var(--t);border-radius:8px;padding:8px;font:inherit;width:100%}input[type=checkbox]{width:22px;height:22px;accent-color:var(--a)}
.btn{background:var(--a);color:#06222b;border:0;border-radius:12px;padding:12px 18px;font:600 15px inherit;cursor:pointer;margin:8px 8px 0 0}.btn.r{background:transparent;color:var(--w);border:1px solid var(--w)}
.bar{height:8px;background:var(--c2);border-radius:6px;overflow:hidden;margin:10px 0}.bar i{display:block;height:100%;width:0;background:var(--a);transition:width .3s}
details{margin-top:8px}summary{cursor:pointer;color:var(--a)}details p,details ol,details ul{margin:6px 0 6px 0}ol,ul{padding-left:20px}li{margin:3px 0}
.row{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.row>*{flex:1;min-width:110px}canvas{display:block;width:100%}
.tabs{display:flex;gap:8px;margin:6px 0 12px}.warn{border-color:var(--w)}
:focus-visible{outline:2px solid var(--a);outline-offset:2px}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style></head><body>
<nav><button data-v="home" onclick="show('home')">Главная</button><button data-v="plan" onclick="show('plan')">Расписание</button><button data-v="work" onclick="openDay(cd)">Трекер</button><button data-v="prog" onclick="show('prog')">Прогресс</button><button data-v="info" onclick="show('info')">Разделы</button></nav>
<main>
<section id="home"><h1>Мой план тренировок</h1><p class="m">Три тренировки в неделю: понедельник, среда, пятница. Всё тело, база для новичка.</p>
<div class="grid"><div class="card"><div class="m">Возраст</div><div class="big">21</div></div><div class="card"><div class="m">Рост</div><div class="big">178 см</div></div><div class="card"><div class="m">Вес</div><div class="big">67–68 кг</div></div><div class="card"><div class="m">Уровень</div><div class="big">Новичок</div></div><div class="card"><div class="m">В неделю</div><div class="big">3 × 45 мин</div></div><div class="card"><div class="m">Завершено</div><div class="big" id="hcnt">0</div></div></div>
<div class="card"><h3>Цели на 3–6 месяцев</h3><ul><li>Вес до 75 кг (реалистично +0,25–0,5 кг в неделю).</li><li>Подтягивания: от 1–2 чистых к 6–10 повторениям, 15 — цель на дальше. Выходы силой — после 8–10 подтягиваний.</li><li>Крепкая прямая спина и сильные руки.</li></ul></div>
<div class="card warn"><h3>Главное условие прогресса — еда</h3><p>Один приём пищи в день не даст набрать массу и объясняет сонливость. Без трёх приёмов пищи вес и сила будут расти очень медленно. Подробности в разделе «Питание».</p></div>
<button class="btn" onclick="show('plan')">Открыть расписание</button></section>
<section id="plan" hidden><h2>Расписание</h2><p class="m">Нажми на день, чтобы открыть тренировку.</p><div id="days"></div><div class="card"><b>Вторник, четверг:</b> ходьба 30–40 мин + домашний блок. <b>Суббота, воскресенье:</b> отдых и прогулка. Подробности в разделе «Восстановление».</div></section>
<section id="work" hidden></section>
<section id="prog" hidden><h2>Прогресс</h2>
<div class="card"><h3>Вес тела</h3><div class="row"><input id="bwv" type="number" step="0.1" placeholder="кг"><button class="btn" onclick="addBW()">Записать вес</button></div><canvas id="c1"></canvas></div>
<div class="card"><h3>Силовые показатели</h3><select id="exsel" onchange="drawProg()"></select><p class="m">Лучший рабочий вес (кг) или повторения за тренировку.</p><canvas id="c2"></canvas></div>
<div class="card"><h3>Подтягивания, отжимания, планка</h3><div class="row"><select id="prsel" onchange="drawProg()"><option>Подтягивания</option><option>Отжимания</option><option>Планка (сек)</option></select><input id="prv" type="number" placeholder="результат"><button class="btn" onclick="addPR()">Записать</button></div><canvas id="c3"></canvas></div>
<h3>История тренировок</h3><div id="hist"></div></section>
<section id="info" hidden><h2>Разделы</h2><div id="infoBox"></div><button class="btn r" onclick="resetAll()">Сбросить все данные</button></section>
</main><script>
const EX={
squat:{n:"Гоблет-присед с гантелью",ic:"🦵",m:"Квадрицепсы, ягодицы, кор",t:["Держи гантель у груди двумя руками, стопы чуть шире плеч.","Опускайся, отводя таз назад; колени идут по линии носков.","Глубина — до параллели бёдер с полом, спина ровная.","Вставай, упираясь в пятки."],b:"Вдох сверху, выдох на подъёме.",e:"Колени заваливаются внутрь, пятки отрываются, спина круглая."},
bench:{n:"Жим гантелей лёжа",ic:"🏋️",m:"Грудь, трицепс, передняя дельта",t:["Лёг на скамью, лопатки сведены и прижаты, стопы на полу.","Гантели над грудью, локти под углом 45–60° к корпусу.","Опусти до уровня груди, затем выжми вверх."],b:"Вдох вниз, выдох на жиме.",e:"Локти разведены на 90°, таз отрывается от скамьи, слишком тяжёлые гантели."},
row:{n:"Тяга гантели к поясу",ic:"🚣",m:"Широчайшие, ромбовидные, бицепс",t:["Колено и рука на скамье, спина параллельна полу.","Тяни гантель к поясу, локоть идёт вдоль корпуса.","Вверху сведи лопатку на 1 секунду, опускай медленно."],b:"Выдох на тяге, вдох на опускании.",e:"Рывок корпусом, тяга кистью вместо локтя, круглая поясница."},
neg:{n:"Подтягивания + негативы",ic:"🧗",m:"Широчайшие, бицепс, предплечья",t:["Хват чуть шире плеч, лопатки вниз. Сначала сделай 1–2 чистых подтягивания, не до отказа.","Затем встань на скамью так, чтобы подбородок был над перекладиной, и опускайся 4–5 секунд до прямых рук.","Сойди на пол и повтори. В каждом подходе: 1–2 чистых + 2–3 негатива. Негативы быстро добавят новые чистые повторения."],b:"Вдох перед спуском, плавный выдох при опускании, без задержки.",e:"Падение за 1 секунду, не до конца выпрямленные руки, раскачивание."},
plank:{n:"Планка",ic:"🧘",m:"Кор, поясница, плечи",t:["Упор на предплечья, локти под плечами.","Тело — прямая линия от головы до пяток.","Напряги пресс и ягодицы, смотри в пол."],b:"Дыши ровно, не задерживай дыхание.",e:"Провисание поясницы, таз вверх, задержка дыхания."},
rdl:{n:"Румынская тяга с гантелями",ic:"🍑",m:"Задняя поверхность бедра, ягодицы, разгибатели спины",t:["Гантели перед бёдрами, ноги на ширине таза, колени чуть согнуты.","Уводи таз назад, гантели скользят по ногам.","Опустись до середины голени, спина прямая; вернись, выводя таз вперёд."],b:"Вдох вниз, выдох вверх.",e:"Круглая спина, приседание вместо наклона, гантели далеко от ног."},
pushup:{n:"Отжимания от пола",ic:"🤸",m:"Грудь, трицепс, плечи, кор",t:["Ладони чуть шире плеч, тело прямое.","Опускай грудь к полу, локти под 45°.","Выжимайся вверх. Если тяжело — упор руками на скамью."],b:"Вдох вниз, выдох вверх.",e:"Провисшая поясница, локти в стороны, неполная амплитуда."},
pulldown:{n:"Тяга верхнего блока к груди",ic:"⬇️",m:"Широчайшие, бицепс",t:["Сядь, зафиксируй бёдра под валиками, хват чуть шире плеч.","Грудь вперёд, лопатки вниз.","Тяни рукоять к верху груди, локти вниз; медленно верни. Нет блока — делай тягу гантели."],b:"Выдох на тяге.",e:"Раскачка корпусом, тяга за голову, плечи у ушей."},
ohp:{n:"Жим гантелей сидя",ic:"🙌",m:"Дельты, трицепс",t:["Сядь со спинкой, гантели на уровне плеч.","Выжимай вверх почти до прямых рук.","Опускай медленно до уровня ушей, пресс напряжён."],b:"Выдох вверх.",e:"Прогиб поясницы, слишком тяжёлые гантели."},
roller:{n:"Ролик для пресса с колен",ic:"⭕",m:"Пресс, кор, широчайшие",t:["Встань на колени на коврик, ролик под плечами.","Спина слегка округлена, пресс напряжён.","Откатись на комфортную дистанцию и вернись, подтягивая таз."],b:"Выдох на возврате.",e:"Провал поясницы, слишком далёкий откат."},
lunge:{n:"Выпады назад с гантелями",ic:"🚶",m:"Квадрицепс, ягодицы",t:["Гантели в руках, шаг назад.","Колено задней ноги почти касается пола, голень передней вертикальна.","Вернись, толкаясь передней пяткой."],b:"Вдох вниз, выдох вверх.",e:"Колено уходит внутрь, короткий шаг, наклон корпуса."},
incline:{n:"Жим гантелей на наклонной скамье",ic:"📐",m:"Верх груди, плечи, трицепс",t:["Угол скамьи 30°, лопатки сведены.","Опусти гантели к верху груди.","Выжми вверх по лёгкой дуге."],b:"Вдох вниз, выдох вверх.",e:"Слишком крутой угол, разведённые локти, рывок."},
dip:{n:"Удержание на брусьях",ic:"🔒",m:"Трицепс, грудь, плечи",t:["Запрыгни в упор на прямых руках, плечи вниз.","Корпус чуть наклонён вперёд, держи позицию.","Если легко — медленно опускайся 3 секунды вниз и поднимайся с помощью ног на скамье."],b:"Дыши ровно.",e:"Плечи у ушей, провал в плечевых суставах."}};
const D=[{ic:"🔥",d:"Понедельник",t:"Тренировка №1",f:"Ноги, грудь, спина",ex:[["squat",3,"8–10","90 с","8–10 кг"],["bench",3,"8–10","90 с","6–8 кг в каждой руке"],["row",3,"8–10","75 с","8–10 кг"],["neg",4,"1–2 чист. + 2–3 негатива","2 мин","собственное тело"],["plank",3,"20–40 с","60 с","собственное тело"]]},
{ic:"⚡",d:"Среда",t:"Тренировка №2",f:"Задняя цепь, жим, тяга",ex:[["rdl",3,"10","90 с","8–10 кг"],["pushup",3,"6–10","90 с","собственное тело"],["pulldown",3,"8–10","90 с","25–30 кг"],["ohp",3,"8–10","75 с","5–6 кг в каждой руке"],["roller",3,"6–8","60 с","короткая амплитуда"]]},
{ic:"🚀",d:"Пятница",t:"Тренировка №3",f:"Ноги, верх груди, спина, брусья",ex:[["lunge",3,"8 на ногу","90 с","4–6 кг в каждой руке"],["incline",3,"8–10","90 с","6 кг в каждой руке"],["row",3,"10","75 с","8–10 кг"],["neg",4,"1–2 чист. + 2–3 негатива","2 мин","собственное тело"],["dip",3,"10–20 с","90 с","собственное тело"]]}];
const INFO=[["Разминка (6–8 мин)","🔥","<ul><li>Лёгкая ходьба или дорожка 3–4 мин.</li><li>Круги плечами, руками, тазом, наклоны головы — по 10 раз.</li><li>10 приседаний без веса, 10 отжиманий с упором на скамью.</li><li>Висы на турнике 2×15 сек и разведение плечевого эспандера 1×15.</li><li>Перед первым упражнением сделай 1 лёгкий подход с половиной рабочего веса.</li></ul>"],
["Заминка (5 мин)","🧊","<ul><li>Ходьба 3 мин, дыхание в ровный ритм.</li><li>Растяжка по 30 сек: грудь в дверном проёме, широчайшие (вис или тяга за стойку), задняя поверхность бедра, квадрицепс, трицепс.</li></ul>"],
["Прогрессия нагрузки","📈","<ul><li>Когда во всех подходах достигнуто верхнее число повторений с хорошей техникой — прибавь вес: +1–2 кг в жимах и тягах гантелей, +2,5 кг в блоке, +2 кг в приседе и тяге.</li><li>Повторения: сначала добавляй их, потом вес.</li><li>Когда в подходе получается 3 чистых — делай 3 чистых + 2–3 негатива, затем 4 чистых и так далее. Негативы удлиняй до 6–8 сек.</li><li>Снижай вес на 10%, если техника разваливается или два занятия подряд не получается рабочее число повторений.</li><li>Записывай всё в трекере: вес, повторы, самочувствие.</li><li>Перетренированность: слабость несколько дней, плохой сон, пропал аппетит, силы падают три тренировки подряд. Тогда неделя лёгких тренировок.</li></ul>"],
["Питание","🍽️","<ul><li>Сейчас ты ешь один раз в день. Цель на ближайшие 2–3 недели: три приёма пищи в день, потом 1–2 перекуса. Добавляй по одному приёму в неделю, чтобы организм привык.</li><li>Ориентир для набора: около 2500–2700 ккал в день.</li><li>Белок 110–130 г (1,6–1,9 г на кг): яйца, курица, говядина, творог, рыба, чечевица, фасоль.</li><li>Жиры около 80 г: орехи, масло, яйца, рыба.</li><li>Углеводы около 330–350 г: крупы, рис, картофель, хлеб, фрукты.</li><li>Простой день: яйца с хлебом утром, обед с мясом и гарниром, ужин с мясом или рыбой и крупой, перекус творог, банан или орехи.</li><li>Вода: 2–2,5 л в день, не ждать жажды.</li><li>Молоко: если тошнота повторяется, попробуй кефир или йогурт и обсуди с врачом. Сонливость, тошноту и «повышенную желчь» стоит показать врачу.</li><li>Добавки не нужны.</li></ul>"],
["Восстановление и дни отдыха","😴","<ul><li>Сон: 7–9 часов, ложись и вставай в одно время. Нерегулярный сон тормозит рост мышц.</li><li><b>Вторник:</b> ходьба 30–40 мин, дома: тяга эспандера 3×15, сгибания рук с гантелями 3×12, ролик 3×6.</li><li><b>Четверг:</b> ходьба, растяжка 10 мин, планка 3×20–30 сек.</li><li><b>Суббота и воскресенье:</b> отдых, прогулка, растяжка.</li><li>Привычки: вставай из-за стола каждый час, взвешивайся раз в неделю утром, фотографируй себя раз в месяц.</li></ul>"],
["Советы тренера","🎯","<ul><li>Техника важнее веса. Лучше 3 чистых подхода, чем 5 рваных.</li><li>Оставляй 2–3 повтора в запасе. До отказа в первые месяцы не нужно.</li><li>Для прямой спины тяни в 1,5 раза больше, чем жмёшь: тяги (гантель, блок, негативы) — главные упражнения для осанки.</li><li>Честный ориентир: +5–7 кг за 3–6 месяцев при регулярной еде — реальный темп; 15 подтягиваний обычно требуют больше времени.</li></ul>"],
["Правила безопасности","⚠️","<ul><li>Астма: носи ингалятор, если он был назначен, и разминайся дольше. При свисте, одышке или кашле остановись, посиди, при необходимости обратись к врачу. Состояние сейчас без симптомов, но стоит сказать врачу о начале тренировок.</li><li>Острая боль в суставе, головокружение, тошнота, боль в груди — немедленно остановись.</li><li>В жимах лёжа и в приседе просить страховку, если тяжело.</li><li>Не прыгай в вес. Прибавляй понемногу.</li><li>Сонливость и тошноту лучше обсудить с врачом: возможно, нужны обычные анализы.</li></ul>"]];
const $=s=>document.querySelector(s),today=()=>new Date().toISOString().slice(0,10);
let S;try{S=JSON.parse(localStorage.getItem("fit1"))}catch(e){}S=S||{cur:{},h:[],bw:[],pr:[]};let cd=0;
const save=()=>{try{localStorage.setItem("fit1",JSON.stringify(S))}catch(e){}};
function show(id){document.querySelectorAll("main section").forEach(s=>s.hidden=s.id!=id);document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("on",b.dataset.v==id));scrollTo(0,0);if(id=="prog")drawProg();if(id=="home")$("#hcnt").textContent=S.h.length}
function openDay(i){cd=i;renderWork();show("work")}
function pbar(){let t=0,n=0;D[cd].ex.forEach((e,j)=>{for(let k=0;k<e[1];k++){t++;const v=S.cur[cd+"_"+j+"_"+k];if(v&&v.d)n++}});$("#pb").style.width=(t?n/t*100:0)+"%"}
function up(k,f,v){S.cur[k]=S.cur[k]||{};S.cur[k][f]=f=="d"?v:(v===""?"":+v);save();pbar()}
function renderWork(){const d=D[cd];let h=`<div class="tabs">${D.map((x,i)=>`<button class="${i==cd?"on":""}" onclick="openDay(${i})">${x.d}</button>`).join("")}</div><h2>${d.t}: ${d.f}</h2><p class="m">Разминка 6–8 мин, затем упражнения, затем заминка 5 мин. Вес выбирай так, чтобы в конце подхода оставалось 2–3 повтора в запасе.</p><div class="bar"><i id="pb"></i></div>`;
d.ex.forEach((e,j)=>{const x=EX[e[0]];let r="";for(let k=0;k<e[1];k++){const key=cd+"_"+j+"_"+k,v=S.cur[key]||{};r+=`<div class="set"><label><input type="checkbox" ${v.d?"checked":""} onchange="up('${key}','d',this.checked)"> ${k+1}</label><input type="number" inputmode="decimal" placeholder="кг" value="${v.w??""}" onchange="up('${key}','w',this.value)"><input type="number" inputmode="numeric" placeholder="повт." value="${v.r??""}" onchange="up('${key}','r',this.value)"></div>`}
h+=`<div class="card"><div class="eh"><span class="ic">${x.ic}</span><div><b>${x.n}</b><div class="m">${x.m}</div></div></div><div class="tags"><span>${e[1]} × ${e[2]}</span><span>отдых ${e[3]}</span></div><p class="m">Старт: ${e[4]}</p>${r}<details><summary>Техника, дыхание, ошибки</summary><p><b>Техника:</b></p><ol>${x.t.map(s=>"<li>"+s+"</li>").join("")}</ol><p><b>Дыхание:</b> ${x.b}</p><p><b>Частые ошибки:</b> ${x.e}</p></details></div>`});
h+=`<button class="btn" onclick="finish()">Завершить тренировку</button>`;$("#work").innerHTML=h;pbar()}
function finish(){const d=D[cd],ex={};let n=0;d.ex.forEach((e,j)=>{for(let k=0;k<e[1];k++){const v=S.cur[cd+"_"+j+"_"+k];if(v&&v.d){n++;const o=ex[e[0]]=ex[e[0]]||{w:0,r:0};o.w=Math.max(o.w,+v.w||0);o.r=Math.max(o.r,+v.r||0)}}});
if(!n){alert("Отметь хотя бы один выполненный подход.");return}
S.h.push({date:today(),day:cd,n,ex});Object.keys(S.cur).forEach(k=>{if(k.startsWith(cd+"_"))delete S.cur[k]});save();alert("Тренировка сохранена. Отличная работа!");renderWork();show("prog")}
function chart(cv,p){const w=cv.parentElement.clientWidth-28,h=160,r=devicePixelRatio||1;cv.width=w*r;cv.height=h*r;cv.style.height=h+"px";const g=cv.getContext("2d");g.scale(r,r);g.font="11px system-ui";g.fillStyle="#8f98a6";
if(!p.length){g.fillText("Данных пока нет. Добавь первую запись.",8,h/2);return}
const ys=p.map(a=>a[1]),mn=Math.min(...ys),sp=(Math.max(...ys)-mn)||1,X=i=>p.length==1?w/2:28+i*(w-56)/(p.length-1),Y=v=>h-28-(v-mn)/sp*(h-62);
g.strokeStyle="#4cc9f0";g.lineWidth=2;g.beginPath();p.forEach((a,i)=>i?g.lineTo(X(i),Y(a[1])):g.moveTo(X(i),Y(a[1])));g.stroke();
p.forEach((a,i)=>{g.fillStyle="#4cc9f0";g.beginPath();g.arc(X(i),Y(a[1]),3.5,0,7);g.fill();g.fillStyle="#8f98a6";g.fillText(a[1],X(i)-8,Y(a[1])-8);g.fillText(a[0],X(i)-14,h-8)})}
function drawProg(){chart($("#c1"),S.bw.map(p=>[p.d.slice(5),p.v]));const id=$("#exsel").value;chart($("#c2"),S.h.filter(h=>h.ex[id]).map(h=>[h.date.slice(5),h.ex[id].w||h.ex[id].r]));const t=$("#prsel").value;chart($("#c3"),S.pr.filter(p=>p.t==t).map(p=>[p.d.slice(5),p.v]));
$("#hist").innerHTML=S.h.length?S.h.slice().reverse().map(h=>`<div class="card"><b>${h.date}</b>, ${D[h.day].d}: выполнено подходов ${h.n}</div>`).join(""):'<p class="m">Завершённых тренировок пока нет. Открой «Трекер» и отметь подходы.</p>'}
function addBW(){const v=+$("#bwv").value;if(!v)return;S.bw.push({d:today(),v});save();$("#bwv").value="";drawProg()}
function addPR(){const v=+$("#prv").value;if(!v)return;S.pr.push({d:today(),t:$("#prsel").value,v});save();$("#prv").value="";drawProg()}
function resetAll(){if(confirm("Удалить все записи тренировок, вес и прогресс? Это нельзя отменить.")){try{localStorage.removeItem("fit1")}catch(e){}S={cur:{},h:[],bw:[],pr:[]};renderWork();show("home")}}
$("#days").innerHTML=D.map((d,i)=>`<div class="card day" onclick="openDay(${i})"><div class="ic">${d.ic}</div><h3>${d.d}: ${d.t}</h3><p class="m">${d.f}. ${d.ex.length} упражнений, около 45 мин</p></div>`).join("");
$("#exsel").innerHTML=Object.keys(EX).map(k=>`<option value="${k}">${EX[k].n}</option>`).join("");
$("#infoBox").innerHTML=INFO.map(a=>`<div class="card"><details><summary>${a[1]} ${a[0]}</summary>${a[2]}</details></div>`).join("");
addEventListener("resize",()=>{if(!$("#prog").hidden)drawProg()});renderWork();show("home");
</script></body></html>
